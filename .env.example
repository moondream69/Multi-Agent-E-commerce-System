# 复制为 .env 后按需填写;Langfuse 密钥生成:
#   openssl rand -base64 32  (NEXTAUTH_SECRET / SALT)
#   openssl rand -hex 32     (ENCRYPTION_KEY)
# compose 会从本文件插值 ${LANGFUSE_*},app 容器经 env_file 读取其余变量。

# 环境剖面:dev=演练(影子模式可见)/ prod=生产(审批锁死)
# 切法:ENVIRONMENT=prod docker compose up -d app(shell 环境优先于本文件插值)。
# ⚠️ prod 不启 sim profile(模拟流量会往生产库灌数据);生产切换须走干净库——
#    dev 落库的演示买家不会被清除,只是不再重 seed。
ENVIRONMENT=dev

# 跨域来源(逗号分隔)。生产形态下前端与 API 同源(单端口 3000),此处实际约束的是
# socket.io 的 Origin 握手:浏览器访问用的每个 origin 都要列出,换 IP 访问时须追加
# http://<局域网IP>:3000,否则实时通道 400 bad-origin(登录页能开但事件流不动)。
# ⚠️ 不可置空:空值等于跳过 Origin 校验,而事件是全局广播、无房间、无鉴权。
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 数据库(业务库 mae;langfuse 库由 postgres 初始化脚本创建)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mae

# Redis(LLM 并发限流 + 短时状态)
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM(DeepSeek,OpenAI 兼容协议)
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MAX_CONCURRENCY=2

# Embedding(Ollama bge-m3,1024 维;留空则走 OpenAI)
EMBEDDING_API_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# Milvus(容器内 app 用 http://milvus:19530;本机开发用 http://localhost:19530)
MILVUS_URI=http://localhost:19530

# Langfuse(观测层;容器内 LANGFUSE_HOST=http://langfuse-server:3000,本机开发 http://localhost:3001)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 认证(生产必改:AUTH_JWT_SECRET 用 openssl rand -hex 32 生成)
AUTH_JWT_SECRET=dev-secret-change-me
AUTH_TOKEN_TTL_HOURS=24
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=

# 审批
APPROVAL_TTL_HOURS=4

# 汇率(实时 API,基准 CNY;失效降级用缓存)。基址不含基准币:客户端自行追加 /{base}(issue #29)
FX_API_URL=https://open.er-api.com/v6/latest

# Langfuse 自托管密钥(compose 插值用)
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
